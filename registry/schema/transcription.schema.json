{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/horizoncove/oracle-bone-decipher/registry/schema/transcription.schema.json",
  "title": "Transcription entry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "glyph_id",
    "catalog_ref",
    "period_group",
    "transcription",
    "damage_level",
    "source_citation",
    "entered_by"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "glyph_id": {"type": "string", "pattern": "^OBD-\\d{6}$"},
    "catalog_ref": {"type": "string", "minLength": 1},
    "period_group": {"type": "string", "minLength": 1},
    "transcription": {"type": "string", "minLength": 1},
    "damage_level": {"type": "string", "enum": ["complete", "minor", "severe"]},
    "source_citation": {"type": "string", "minLength": 1},
    "entered_by": {"type": "string", "minLength": 1},
    "note": {"type": "string"}
  }
}
